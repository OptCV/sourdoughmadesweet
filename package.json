    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "owner:provision": "tsx scripts/provision-owner.ts",
    "deploy": "npm run build \u0026\u0026 wrangler pages deploy dist",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "lucide-react": "1.70.0",
