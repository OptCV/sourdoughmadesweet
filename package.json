    "@hookform/resolvers": "7.0.3",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "better-auth": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "hono": "4.13.7",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
